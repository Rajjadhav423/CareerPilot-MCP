# Existing CareerPilot Spring Boot API base URL, including /api/v1 when required
CAREERPILOT_API_URL=https://your-careerpilot-api.example.com/api/v1

# Local development only. Do not use a shared token for a public multi-user server.
CAREERPILOT_API_TOKEN=

# This initial version uses stdio for local MCP clients.
MCP_TRANSPORT=stdio
