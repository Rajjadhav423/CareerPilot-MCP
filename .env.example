# Remote MCP
PORT=3001
CAREERPILOT_BACKEND_URL=http://localhost:8080
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
MCP_CORS_ORIGINS=http://localhost:3000
# Public address clients use (https in production). Sets the OAuth resource and the only accepted Host.
MCP_PUBLIC_URL=http://localhost:3001
# Same value as the API's MCP_SERVICE_SECRET; at least 32 random characters. The MCP server signs its own
# short-lived tokens for the API with it, so users' OAuth tokens are never passed through.
MCP_SERVICE_SECRET=
# Requests per user per minute
MCP_RATE_LIMIT_PER_MINUTE=60
BACKEND_TIMEOUT_MS=20000

# Development-only stdio mode. Use a real user Clerk session token; never share it.
MCP_TRANSPORT=http
CAREERPILOT_STDIO_TOKEN=
